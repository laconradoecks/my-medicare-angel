# Copy to .env and fill in to take the lead forms live.
#
# Where the help, contact, booking and referral forms POST their JSON payload.
# Leave this unset: production builds default to /api/lead.php, the handler in
# public/api/ that runs on the site's own hosting and mails enquiries on. Set it
# only to point the forms somewhere else. In dev the forms stay in preview mode
# and send nothing.
VITE_FORM_ENDPOINT=
