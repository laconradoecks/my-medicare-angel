# My Medicare Angel — Apache config for cPanel shared hosting (Namecheap).
#
# This ships in the build output, so uploading dist/ is all that's needed.
# Netlify and Vercel ignore it; they read netlify.toml / vercel.json instead.
#
# Every block is wrapped in <IfModule> so a host missing a module degrades
# instead of throwing a 500.

# ---------------------------------------------------------------------------
# SPA routing — without this, every URL except "/" returns 404 on Apache.
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- HTTPS redirect -------------------------------------------------------
  # Leave this commented until cPanel shows an active AutoSSL certificate for
  # the domain. Enabling it first makes the site unreachable behind a cert
  # warning. Once SSL is issued, remove the leading "#" from the next two lines.
  #
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Never rewrite a request that maps to a real file or directory. This is what
  # keeps /assets/*, /logo/*, sitemap.xml and robots.txt served directly.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Leave AutoSSL's validation path alone.
  RewriteRule ^\.well-known/ - [L]

  # Everything else is a React Router path: hand it index.html and let the app
  # resolve it (including its own 404 page).
  RewriteRule ^ index.html [L]
</IfModule>

# ---------------------------------------------------------------------------
# Compression — roughly a 3.5x reduction on the JS and CSS bundles.
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/manifest+json image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# Caching. Vite fingerprints filenames in /assets, so those are immutable.
# index.html must never be cached, or visitors keep loading the old build.
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|svg|png|jpg|jpeg|webp|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(html|json|webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Same headers the Netlify and Vercel configs set.
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---------------------------------------------------------------------------
# MIME types cPanel does not always declare.
# ---------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
</IfModule>

# ---------------------------------------------------------------------------
# Hardening
# ---------------------------------------------------------------------------
Options -Indexes

<FilesMatch "^\.(env|git|gitignore)">
  Require all denied
</FilesMatch>
